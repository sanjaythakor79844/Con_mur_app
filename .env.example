# Backend API Configuration
# Get production URLs from your backend deployment
VITE_API_BASE_URL=your_backend_api_url_here

# Dedicated Blood Report Upload API Backend
VITE_BLOOD_REPORT_API_BASE_URL=your_blood_report_api_url_here

# New Feature Backend Configuration
VITE_FEATURE_API_BASE_URL=your_feature_api_url_here

# Firebase Configuration
# Get these values from your Firebase project console
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
